# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Model server (any OpenAI-compatible API) --------------------------------
# LM Studio / Bionic: `lms server start` serves http://localhost:1234/v1
# ARCHIVIST_LLM_BASE_URL=http://localhost:1234/v1
# ARCHIVIST_LLM_API_KEY=not-needed      # local servers ignore it; set it for cloud APIs

# --- LangSmith tracing (optional) --------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2-your-langsmith-api-key
LANGSMITH_PROJECT=archivist

# --- Archivist settings (optional; defaults live in src/archivist/config.py) -
# ARCHIVIST_CHAT_MODEL=qwen/qwen3.5-9b
# ARCHIVIST_CHAT_TEMPERATURE=0.2
# ARCHIVIST_CHAT_REASONING_EFFORT=none  # unset it if the server rejects the parameter
# ARCHIVIST_EMBEDDING_MODEL=text-embedding-qwen3-embedding-0.6b
# ARCHIVIST_CHUNK_SIZE=1000
# ARCHIVIST_CHUNK_OVERLAP=200
# ARCHIVIST_RETRIEVAL_TOP_K=4
# ARCHIVIST_RETRIEVAL_MAX_DISTANCE=1.2
# ARCHIVIST_DATA_DIR=data
# ARCHIVIST_STORAGE_DIR=storage
